target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or app, you might want to share your .python-version.
#   Web applications, libraries, and tools should usually ignore it.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different versions of python,
#   it could cause dependency conflicts.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains exact versions of dependency trees.
#   For projects running in production, version control poetry.lock is recommended.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains exact versions of dependency trees.
#pdm.lock
#   pdm local configuration
.pdm-python
.pdm-db/

# PEP 582; used by e.g. github.com/lincolnloop/layman and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath vars
*.sage.py

